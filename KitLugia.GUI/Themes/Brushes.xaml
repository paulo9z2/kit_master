<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F0F23" Offset="0.0"/>
        <GradientStop Color="#181825" Offset="0.4"/>
        <GradientStop Color="#1A0A2A" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ModernGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00D4AA" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AccentColor" Color="#00D4AA"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentCoral" Color="#FF6B6B"/>

    <SolidColorBrush x:Key="SidebarBackground" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#25FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#338B5CF6"/>

    <SolidColorBrush x:Key="NotificationSuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="NotificationErrorBrush" Color="#C42B1C"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextMuted" Color="#858585"/>
    <SolidColorBrush x:Key="TextDescription" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="TextGold" Color="#FFD700"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>

    <DropShadowEffect x:Key="DropShadowEffect" Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>

</ResourceDictionary>
